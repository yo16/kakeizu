# ============================================================
# 環境変数の設定例
# このファイルをコピーして .env.local を作成し、実際の値を設定してください
# .env.local は Git 管理外（.gitignore に登録済み）
# ============================================================

# ------------------------------------------------------------
# Supabase
# ------------------------------------------------------------
# Supabase Project URL（公開可: NEXT_PUBLIC_ プレフィックス）
# ローカル開発 (supabase start で得られる値):
# NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Anon Key（公開可: NEXT_PUBLIC_ プレフィックス）
# ローカル開発 (supabase status で取得):
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ... (supabase status で取得)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Key（Server only: 絶対に公開しないこと）
# ローカル開発 (supabase status で取得):
# SUPABASE_SERVICE_ROLE_KEY=eyJ... (supabase status で取得)
SUPABASE_SERVICE_ROLE_KEY=

# Supabase JWT Secret（Server only: Edge での JWT 検証用）
SUPABASE_JWT_SECRET=

# Google OAuth Client ID / Secret（Server only: Supabase Auth Google プロバイダ設定用）
# Google Cloud Console で OAuth 2.0 クライアント ID を作成して取得
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=

# ------------------------------------------------------------
# Stripe
# ------------------------------------------------------------
# Stripe Publishable Key（公開可: NEXT_PUBLIC_ プレフィックス）
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Secret Key（Server only: 絶対に公開しないこと）
STRIPE_SECRET_KEY=

# Stripe Webhook Secret（Server only: Webhook 署名検証用）
STRIPE_WEBHOOK_SECRET=

# Stripe Price ID: Basic プラン（月額）
STRIPE_PRICE_BASIC_JPY_MONTHLY=

# Stripe Price ID: Standard プラン（月額）
STRIPE_PRICE_STANDARD_JPY_MONTHLY=

# ------------------------------------------------------------
# アプリ設定
# ------------------------------------------------------------
# サイト URL（公開可: OAuth リダイレクト等に使用）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------
# ログ設定（Server only）
# ------------------------------------------------------------
# ログレベル: debug | info | warn | error (default: info)
LOG_LEVEL=info

# ------------------------------------------------------------
# 通知メール（将来: Server only）
# ------------------------------------------------------------
# Resend API Key（MVP では Supabase Auth 標準メールを使用するため不要）
# RESEND_API_KEY=
