# DBマイグレーションテスト用の環境変数
#
# このファイルを .env.test.local としてコピーして使用する:
#   cp .env.test.local.example .env.test.local
#
# ローカル Supabase の値は `supabase status` コマンドで確認できる。
# デフォルト値は supabase/config.toml の設定に基づく。

# ローカル Supabase の API URL
# デフォルト: http://127.0.0.1:54321 (supabase/config.toml の [api].port)
TEST_SUPABASE_URL=http://127.0.0.1:54321

# ローカル Supabase の anon キー
# `supabase status` で確認するか、以下のデフォルト値を使用する
TEST_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRFA0NiK7W9oHa-k2Tlmjp5FDrFY7jNeX5s14iFEgEk

# ローカル Supabase の service_role キー
# `supabase status` で確認するか、以下のデフォルト値を使用する
TEST_SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hj04zWl196z2-SBc0
